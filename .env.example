# Copy to .env and fill from Supabase → Project Settings → API
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"

# -----------------------------------------------------------------------------
# Server-only secrets (Edge Function) — NEVER use a VITE_ prefix.
# Local: put in .env and run `supabase functions serve faq-assist --env-file .env`
# Cloud (production): project owner must set secrets, then deploy:
#   supabase link --project-ref <ref>
#   supabase db push
#   supabase secrets set DEEPSEEK_API_KEY=... ASSISTANT_IP_HASH_SALT=...
#   supabase functions deploy faq-assist
# Do not commit .env.
# -----------------------------------------------------------------------------
# DEEPSEEK_API_KEY="sk-your-deepseek-key"
# ASSISTANT_IP_HASH_SALT="paste-a-long-random-hex-string"

# -----------------------------------------------------------------------------
# LOCAL DEV ONLY — omit on production / GitHub Pages / Vercel / Netlify.
# When set, the chatbot calls local `supabase functions serve` instead of cloud.
# Restart `npm run dev` after changing.
# -----------------------------------------------------------------------------
# VITE_SUPABASE_FUNCTIONS_URL="http://127.0.0.1:54321/functions/v1"
# Optional (defaults to the public local Supabase demo anon key):
# VITE_SUPABASE_FUNCTIONS_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0"
